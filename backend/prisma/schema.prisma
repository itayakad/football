generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OffenseStyle {
  RUN_HEAVY
  BALANCED
  PASS_HEAVY
}

enum DefenseStyle {
  AGGRESSIVE
  BALANCED
  PREVENT
}

enum OffensivePhilosophy {
  WEST_COAST
  VERTICAL_SPREAD
  SMASHMOUTH
  RPO_HEAVY
  QUICK_GAME
  PLAY_ACTION_HEAVY
}

model League {
  id    String @id @default(cuid())
  name  String
  tier  Int
  teams Team[]
  seasonHistories LeagueSeasonHistory[]
}

model Team {
  id            String       @id @default(cuid())
  name          String
  leagueId      String
  league        League       @relation(fields: [leagueId], references: [id])
  offenseRating Int
  defenseRating Int
  offenseStyle  OffenseStyle @default(BALANCED)
  offensivePhilosophy OffensivePhilosophy @default(WEST_COAST)
  defenseStyle  DefenseStyle @default(BALANCED)
  // Team's 9-play loadouts. Identity is determined entirely by these picks.
  // Stored as Json arrays of play IDs; backend validates against playLibrary.
  offensivePlays Json?
  defensivePlays Json?
  money         Int          @default(150000000)
  personnel     Personnel[]
  schemes       TeamScheme[]
  teamSeasonHistories TeamSeasonHistory[]
  homeMatches   Match[]      @relation("HomeTeam")
  awayMatches   Match[]      @relation("AwayTeam")
}

model TeamScheme {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  unit      String
  name      String
  plays     Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, unit])
  @@unique([teamId, unit, name])
}

// Unified roster model covering coaches (HC/OC/DC) and players (QB/RB/WR/...).
// Stat labels and archetype/philosophy names are derived from `position` at read time.
model Personnel {
  id                String   @id @default(cuid())
  name              String
  position          String           // 'HC' | 'OC' | 'DC' | 'QB' | 'RB' | 'WR' | 'TE' | 'OL' | 'DE' | 'DT' | 'LB' | 'CB' | 'S'
  overall           Int      @default(60)
  stat1             Int      @default(60)
  stat2             Int      @default(60)
  careerWins        Int      @default(0)
  careerLosses      Int      @default(0)
  titles            Int      @default(0)
  salary            Int      @default(2700000)
  contractYearsLeft Int      @default(4)
  age               Int      @default(25)
  yearsWithTeam     Int      @default(1)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id])

  @@index([teamId, position])
}

model SeasonHistory {
  id        String   @id @default(cuid())
  season    Int
  createdAt DateTime @default(now())
  leagues   LeagueSeasonHistory[]
  teams     TeamSeasonHistory[]
}

model LeagueSeasonHistory {
  id               String        @id @default(cuid())
  seasonHistoryId  String
  seasonHistory    SeasonHistory @relation(fields: [seasonHistoryId], references: [id])
  season           Int
  leagueId         String
  league           League        @relation(fields: [leagueId], references: [id])
  leagueName       String
  tier             Int
  championTeamId   String
  championTeamName String
  mvpPlayerId      String?
  mvpPlayerName    String?
  mvpTeamName      String?
  biggestGame      String?
  standings        Json
  awards           Json?
  playoffBracket   Json?
  createdAt        DateTime      @default(now())

  @@unique([season, leagueId])
}

model TeamSeasonHistory {
  id               String        @id @default(cuid())
  seasonHistoryId  String
  seasonHistory    SeasonHistory @relation(fields: [seasonHistoryId], references: [id])
  season           Int
  teamId           String
  team             Team          @relation(fields: [teamId], references: [id])
  teamName         String
  leagueName       String
  tier             Int
  rank             Int
  wins             Int
  losses           Int
  ties             Int
  pointsFor        Int
  pointsAgainst    Int
  diff             Int
  resultLabel      String
  createdAt        DateTime      @default(now())

  @@unique([season, teamId])
}

model RetirementHistory {
  id         String   @id @default(cuid())
  season     Int
  playerId   String
  playerName String
  teamId     String
  teamName   String
  age        Int
  overall    Int
  story      String
  createdAt  DateTime @default(now())
}

model Match {
  id           String  @id @default(cuid())
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int     @default(0)
  awayScore    Int     @default(0)
  week         Int
  played       Boolean @default(false)
  leagueId     String
  // null for regular season; "WILD_CARD" | "SEMI" | "FINAL" for playoffs.
  playoffRound String?
  // Per-match tactical gameplans for each side. Set by AI coach pre-match,
  // overridable by user for their team. Shape: { offensivePlays, defensivePlays }.
  homeGameplan Json?
  awayGameplan Json?
}

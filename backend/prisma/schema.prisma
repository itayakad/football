generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OffenseStyle {
  RUN_HEAVY
  BALANCED
  PASS_HEAVY
}

enum DefenseStyle {
  AGGRESSIVE
  BALANCED
  PREVENT
}

enum OffensivePhilosophy {
  WEST_COAST
  VERTICAL_SPREAD
  SMASHMOUTH
  RPO_HEAVY
  QUICK_GAME
  PLAY_ACTION_HEAVY
}

model League {
  id    String @id @default(cuid())
  name  String
  tier  Int
  teams Team[]
  seasonHistories LeagueSeasonHistory[]
}

model Team {
  id            String       @id @default(cuid())
  name          String
  leagueId      String
  league        League       @relation(fields: [leagueId], references: [id])
  offenseRating Int
  defenseRating Int
  offenseStyle  OffenseStyle @default(BALANCED)
  offensivePhilosophy OffensivePhilosophy @default(WEST_COAST)
  defenseStyle  DefenseStyle @default(BALANCED)
  // Team's 9-play loadouts. Identity is determined entirely by these picks.
  // Stored as Json arrays of play IDs; backend validates against playLibrary.
  offensivePlays Json?
  defensivePlays Json?
  money         Int          @default(150000000)
  players       Player[]
  coaches       Coach[]
  schemes       TeamScheme[]
  listings      TransferListing[]
  transferOffers TransferOffer[]
  teamSeasonHistories TeamSeasonHistory[]
  homeMatches   Match[]      @relation("HomeTeam")
  awayMatches   Match[]      @relation("AwayTeam")
}

model TeamScheme {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  unit      String
  name      String
  plays     Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, unit])
  @@unique([teamId, unit, name])
}

model Coach {
  id                    String   @id @default(cuid())
  name                  String
  role                  String
  philosophy            String
  developmentSpecialty  String
  aggression            Int
  reputation            Int
  // Coach OVRs used by the play-driven engine.
  //   - HEAD_COACH: overall (general); offenseRating + defenseRating drive
  //     the offensive/defensive playcalling RNG buckets respectively.
  //   - OC / DC: overall is a play-strength multiplier in the engine.
  overall               Int      @default(60)
  offenseRating         Int      @default(60)
  defenseRating         Int      @default(60)
  careerWins            Int      @default(0)
  careerLosses          Int      @default(0)
  titles                Int      @default(0)
  hotSeat               Int      @default(20)
  yearsWithTeam         Int      @default(1)
  age                   Int      @default(48)
  teamId                String?
  team                  Team?    @relation(fields: [teamId], references: [id])
}

model Player {
  id                 String  @id @default(cuid())
  name               String
  position           String
  overall            Int
  potential          Int
  age                Int
  depthOrder         Int     @default(0)
  salary             Int     @default(2500000)
  contractYearsLeft  Int     @default(2)
  extensionEligible  Boolean @default(false)
  teamId             String
  team               Team    @relation(fields: [teamId], references: [id])
  transferListing    TransferListing?
}

model TransferListing {
  id           String   @id @default(cuid())
  playerId     String   @unique
  player       Player   @relation(fields: [playerId], references: [id])
  sellerTeamId String
  sellerTeam   Team     @relation(fields: [sellerTeamId], references: [id])
  askingPrice  Int
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  offers       TransferOffer[]
}

model TransferOffer {
  id             String          @id @default(cuid())
  listingId      String
  listing        TransferListing @relation(fields: [listingId], references: [id])
  buyerTeamId    String
  buyerTeam      Team            @relation(fields: [buyerTeamId], references: [id])
  amount         Int
  status         String          @default("PENDING")
  createdAt      DateTime        @default(now())
}

model SeasonHistory {
  id        String   @id @default(cuid())
  season    Int
  createdAt DateTime @default(now())
  leagues   LeagueSeasonHistory[]
  teams     TeamSeasonHistory[]
}

model LeagueSeasonHistory {
  id               String        @id @default(cuid())
  seasonHistoryId  String
  seasonHistory    SeasonHistory @relation(fields: [seasonHistoryId], references: [id])
  season           Int
  leagueId         String
  league           League        @relation(fields: [leagueId], references: [id])
  leagueName       String
  tier             Int
  championTeamId   String
  championTeamName String
  mvpPlayerId      String?
  mvpPlayerName    String?
  mvpTeamName      String?
  biggestGame      String?
  standings        Json
  awards           Json?
  playoffBracket   Json?
  createdAt        DateTime      @default(now())

  @@unique([season, leagueId])
}

model TeamSeasonHistory {
  id               String        @id @default(cuid())
  seasonHistoryId  String
  seasonHistory    SeasonHistory @relation(fields: [seasonHistoryId], references: [id])
  season           Int
  teamId           String
  team             Team          @relation(fields: [teamId], references: [id])
  teamName         String
  leagueName       String
  tier             Int
  rank             Int
  wins             Int
  losses           Int
  ties             Int
  pointsFor        Int
  pointsAgainst    Int
  diff             Int
  resultLabel      String
  createdAt        DateTime      @default(now())

  @@unique([season, teamId])
}

model TradeHistory {
  id           String   @id @default(cuid())
  season       Int
  playerId     String
  playerName   String
  fromTeamId   String
  fromTeamName String
  toTeamId     String
  toTeamName   String
  fee          Int
  story        String
  createdAt    DateTime @default(now())
}

model RetirementHistory {
  id         String   @id @default(cuid())
  season     Int
  playerId   String
  playerName String
  teamId     String
  teamName   String
  age        Int
  overall    Int
  story      String
  createdAt  DateTime @default(now())
}

model Match {
  id           String  @id @default(cuid())
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int     @default(0)
  awayScore    Int     @default(0)
  week         Int
  played       Boolean @default(false)
  leagueId     String
  // null for regular season; "WILD_CARD" | "SEMI" | "FINAL" for playoffs.
  playoffRound String?
  // Per-match tactical gameplans for each side. Set by AI coach pre-match,
  // overridable by user for their team. Shape: { offensivePlays, defensivePlays }.
  homeGameplan Json?
  awayGameplan Json?
}
